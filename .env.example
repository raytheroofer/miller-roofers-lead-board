# PostgreSQL (Neon / Vercel Postgres / Supabase / Railway)
DATABASE_URL="postgresql://postgres:password@localhost:5432/mrs_leaderboard"

# Auth.js / NextAuth. Generate a random string for any real deploy.
AUTH_SECRET="replace-with-a-long-random-string"
# Optional alias
# NEXTAUTH_SECRET="same-as-AUTH_SECRET"
# AUTH_URL="http://localhost:43177"

# Legacy password fallback; never use for Cody’s individual account.
AUTH_PASSWORD="track-only"

# Recovery defaults to owner-only, with the explicit Cody account below.
OWNER_ONLY="true"
OWNER_EMAIL="ray@mrsroofers.com"
# Set a private owner-specific password before entering live customer data.
# The existing AUTH_PASSWORD remains the fallback until this is configured.
OWNER_PASSWORD=""
# Set privately to enable cody@mrsroofers.com only. At least 16 characters,
# different from owner/shared passwords. Leave OWNER_ONLY=true.
# Changing/removing this value revokes Cody’s existing sessions.
CODY_PASSWORD=""
FEATURE_WEBHOOK_INBOX="false"

# Comma-separated allowlist. Defaults match Ray's locked list if omitted.
ALLOWED_EMAILS="ray@mrsroofers.com,cody@mrsroofers.com"

# Firstmate service login (digests conceptually go here; this is the ops login)
FIRSTMATE_EMAIL="firstmate@mrsroofers.com"
FIRSTMATE_PASSWORD="firstmate-local"

# Optional Google OAuth. Leave blank to use the password login only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional shared secret for webhook stubs. If set, send header x-mrs-webhook-secret.
WEBHOOK_SECRET=""

# Phase 1 locks — keep these false until Ray unlocks Phase 2
FEATURE_TWILIO_LIVE="false"
FEATURE_ROOFR_WRITE="false"

# Read-only job links use MRS's verified Roofr team by default.
ROOFR_TEAM_ID="137502"
