# PostgreSQL (Neon / Vercel Postgres / Supabase / Railway)
DATABASE_URL="postgresql://postgres:password@localhost:5432/mrs_leaderboard"

# Auth.js / NextAuth. Generate a random string for any real deploy.
AUTH_SECRET="replace-with-a-long-random-string"
# Optional alias
# NEXTAUTH_SECRET="same-as-AUTH_SECRET"
# AUTH_URL="http://localhost:43177"

# Initial owner bootstrap setup (used only once when no user has set a password)
BOOTSTRAP_INVITE_SECRET="replace-with-a-random-bootstrap-secret"
BOOTSTRAP_OWNER_EMAIL="ray@mrsroofers.com"

# Comma-separated allowlist. Defaults match Ray's locked list if omitted.
ALLOWED_EMAILS="ray@mrsroofers.com,austin@mrsroofers.com,cody@mrsroofers.com"

# Firstmate ops login (optional service account login for automated tasks)
FIRSTMATE_EMAIL="firstmate@mrsroofers.com"
FIRSTMATE_PASSWORD=""

# Optional email delivery via Resend for invite links (if unset, admin copies link manually)
RESEND_API_KEY=""
EMAIL_FROM="MRS Leaderboard <onboarding@resend.dev>"

# Optional Google OAuth. Leave blank to use password logins only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional shared secret for webhook stubs. If set, send header x-mrs-webhook-secret.
WEBHOOK_SECRET=""

# Phase 1 locks — keep these false until Ray unlocks Phase 2
FEATURE_TWILIO_LIVE="false"
FEATURE_ROOFR_WRITE="false"
